# ─────────────────────────────────────────────────────────────────────────────
# Claimfold configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
# Every value here is per-INSTALL. Credentials that differ per tenant
# (Instagram tokens, Meta app id/secret) live in the database, encrypted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Production / Docker:
#   DATABASE_URL=postgres://claimfold:claimfold@postgres:5432/claimfold
# Local dev with no Postgres installed — embedded Postgres (PGlite), zero setup:
#   DATABASE_URL=pglite://./data/dev
DATABASE_URL=pglite://./data/dev

# ── Secrets ──────────────────────────────────────────────────────────────────
# Wraps every stored Instagram token (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS MEANS EVERY CONNECTED ACCOUNT MUST RECONNECT.
ENCRYPTION_KEY=

# Signs session cookies. At least 32 characters — the app refuses to start
# without it rather than running on an undefined default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ── Accounts ─────────────────────────────────────────────────────────────────
# Registration closes by itself once this install has its first user, so a
# fresh box can be claimed and a running one cannot be enrolled by strangers.
# Set to true only while adding a colleague, then unset it.
ALLOW_SIGNUP=false

# ── URLs ─────────────────────────────────────────────────────────────────────
# Which port the install is reachable on. Compose publishes this; the container
# always listens on 3000 internally.
PORT=3100

# Public origin of this install. Must be reachable by Meta's crawler over HTTPS
# in production — Instagram fetches slide images from it server-to-server.
#
# This MUST match PORT above. It is the Better Auth baseURL and the Instagram
# OAuth redirect origin, so a mismatch registers a redirect URI Meta will never
# match — and the failure only surfaces at connect time, not at boot.
APP_URL=http://localhost:3100

# Behind a proxy that terminates TLS (Caddy, nginx, Traefik)? Set this to true.
# The origin is then https even though APP_URL may say http, and the session
# cookie must still be marked Secure. Leaving it unset with an http:// APP_URL
# in production is refused at startup rather than silently downgraded.
TRUST_PROXY=

# Where rendered JPEGs are served from. Must be a plain, unauthenticated,
# redirect-free path. Signed/expiring URLs (e.g. S3 presigned) DO NOT WORK —
# Meta's fetcher fails on them.
PUBLIC_ASSET_URL=http://localhost:3100/assets

# ── AI ───────────────────────────────────────────────────────────────────────
# Which backend to use: anthropic | openai
# Only the selected provider's key is required.
LLM_PROVIDER=openai

# Anthropic — https://console.anthropic.com/settings/keys
# Note: API credits are billed separately from a Claude.ai subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI — https://platform.openai.com/api-keys
# Needs Responses API access with the web_search tool: the fact-check stage
# depends on server-side search.
OPENAI_API_KEY=

# Per-tier models. Leave blank for the defaults shown.
# Raise DEEP to gpt-5.6-sol if a niche justifies the extra cost and latency.
#   OPENAI_MODEL_FAST=gpt-5.6-luna
#   OPENAI_MODEL_BALANCED=gpt-5.6-terra
#   OPENAI_MODEL_DEEP=gpt-5.6-terra
#
# Setting OPENAI_MODEL pins EVERY tier to one model. Useful for cost control
# or reproducing a run exactly; leave it unset to let tiers apply.
# OPENAI_MODEL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where rendered JPEGs and uploads live on disk. Must be the same filesystem for
# web and worker — the worker writes, web serves. Docker mounts a named volume
# here; back this up alongside the database.
STORAGE_DIR=./storage

# ── Rendering ────────────────────────────────────────────────────────────────
# Concurrent Chromium pages. Raise on beefier machines.
# Chromium is sized for a 4GB box at 2; each extra page is roughly 300MB.
RENDER_CONCURRENCY=3

# ── Worker ───────────────────────────────────────────────────────────────────
# How often the publish queue is checked, in seconds.
WORKER_TICK_SECONDS=30

# How long a claimed post may go without progress before another worker may
# take it over, in minutes. Must exceed the slowest realistic render+upload, or
# two workers publish the same carousel.
PUBLISH_LEASE_MINUTES=20

# Where the worker touches a file each tick, so the container healthcheck can
# fail on staleness rather than on the process being gone. A hung tick keeps
# the process alive, which is the state worth catching.
WORKER_HEARTBEAT_PATH=/tmp/claimfold-worker-heartbeat

# How long finished jobs and unreferenced render output are kept, in days.
# Set to 0 to keep everything and manage retention yourself.
RETENTION_DAYS=30

# ── Database ─────────────────────────────────────────────────────────────────
# Maximum pooled connections per process. Applies to real Postgres only.
DB_POOL_MAX=10

# ── Trends ───────────────────────────────────────────────────────────────────
# Wikimedia and GDELT ask for a contact address in the User-Agent so they can
# reach you before they rate-limit you. Strongly recommended.
TRENDS_CONTACT=

# Where the trends HTTP cache is written. Pruned on write; safe to delete.
TRENDS_CACHE_DIR=./data/trends-cache

# ── Licensing ────────────────────────────────────────────────────────────────
# Ed25519-signed key, verified offline — no network, no phoning home. Blank runs
# in evaluation mode, which is the honest default and restricts nothing.
#
# Nothing is gated on the tier yet: an invalid or expired key shows a banner and
# changes no behaviour. Turning limits on is a separate, deliberate change.
LICENSE_KEY=
#
# The vendor's PUBLIC signing key, base64 of the raw 32 bytes. Ships with the
# build; without it a key cannot be checked and the interface says so rather than
# trusting it. Generate a pair with: npm run license:keygen
LICENSE_PUBLIC_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error. The worker emits one JSON object per line, so
# this is a filter a log shipper can rely on rather than prose in a terminal.
#
# Previously documented here and read by nothing; it is wired up now.
LOG_LEVEL=info

# ── Development tooling ──────────────────────────────────────────────────────
# Read only by scripts in scripts/, never by the app. Listed so that every
# variable the repository reads is documented in one place.
#
# The account `npm run db:seed` creates, and that `npm run capture` signs in as.
#   SEED_EMAIL=dev@claimfold.local
#   SEED_PASSWORD=claimfold-dev-2026
#
# Where `npm run capture` points its browser.
#   CAPTURE_URL=http://localhost:3100
